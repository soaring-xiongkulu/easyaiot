# EasyAIoT PANEL 配置（复制为 panel.env）

PANEL_LISTEN_PORT=9200
PANEL_IMAGE=easyaiot/panel:latest
PANEL_NAME=easyaiot-panel

# 访问令牌（非空时前端「PANEL_TOKEN」输入框 / 请求头 X-Panel-Token）
PANEL_TOKEN=

# 危险操作 clean 等（默认开启；设为 0 可关闭）
PANEL_ALLOW_DANGEROUS=1

# EasyAIoT WEB 管控台（PANEL 内「打开平台」按钮）
# 留空则按当前访问主机 + 端口自动拼接，例如 http://192.168.1.10:8888
PANEL_WEB_URL=
PANEL_WEB_PORT=8888

PANEL_JOB_TIMEOUT=7200
# 应用部署历史任务保留条数（含日志）
PANEL_JOB_HISTORY_LIMIT=15

# 仓库根（compose 挂载到容器 /easyaiot）；默认由 install.sh / PANEL 自动推断
# EASYAIOT_ROOT=/path/to/easyaiot

# 是否在「一键部署」里再装一层 Docker PANEL。
# 安装包/桌面端默认应为 0：包本身就是 PANEL，再装会抢 9200。
# 仅源码仓库里用 Docker 跑 PANEL 时才设为 1。
# EASYAIOT_ENABLE_PANEL=0

# 一键部署脚本（相对 EASYAIOT_ROOT 或绝对路径）
# Linux 默认: .scripts/docker/install_linux.sh
# macOS:     .scripts/docker/install_mac.sh（仅镜像部署）
# Windows:   .scripts/docker/install_windows.sh（仅镜像部署）
# INSTALL_SCRIPT=.scripts/docker/install_linux.sh

# 宿主机局域网 IP（GB28181/ZLM 媒体地址）。PANEL 容器版会尽量自动探测；
# 若探测不准（例如多网卡），请手动指定，例如：
# HOST_IP=192.168.1.100
