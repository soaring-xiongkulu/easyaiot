<?xml version="1.0" encoding="utf-8"?>
<!-- Data-extraction rules (API 31+): exclude the encrypted prefs file from
     cloud backup and device-to-device transfer for the same reason as
     backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="wails_secure.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="wails_secure.xml" />
    </device-transfer>
</data-extraction-rules>
