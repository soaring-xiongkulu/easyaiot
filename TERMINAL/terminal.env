# EasyAIoT TERMINAL 部署配置（bash TERMINAL/install.sh install 时自动生成本文件）
# 镜像（预构建仓库镜像或本地构建标签）
TERMINAL_IMAGE=easyaiot/terminal:latest
# 宿主机监听端口（容器内固定 8080；WEB 助手默认按 9245 访问）
TERMINAL_LISTEN_PORT=9245
TZ=Asia/Shanghai
# 中间件快捷连接的目标主机（默认经宿主网关访问 docker-compose 发布的中间件端口；
# 桌面版无需设置，默认 localhost）。也可用 EASYAIOT_POSTGRES_HOST / EASYAIOT_REDIS_HOST
# 等按服务覆盖，详见 TERMINAL/README.md「中间件快捷配置」。
# EASYAIOT_MIDDLEWARE_HOST=host.docker.internal
