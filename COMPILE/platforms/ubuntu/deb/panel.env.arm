# EasyAIoT PANEL — ARM64 由 deb 安装写入，可用 dpkg-reconfigure / 手动编辑

PANEL_LISTEN_HOST=0.0.0.0
PANEL_LISTEN_PORT=9200

# 访问令牌（非空时请求头需 X-Panel-Token）
PANEL_TOKEN=

# 危险操作 clean 等（默认开启；设为 0 可关闭）
PANEL_ALLOW_DANGEROUS=1
PANEL_JOB_TIMEOUT=7200

# EasyAIoT 运行根。默认使用 deb 内置 runtime（不依赖外部源码仓库）。
EASYAIOT_ROOT=/opt/easyaiot-panel/runtime

# 安装包本身即为 PANEL（systemd 托管 easyaiot-panel），部署时不必再装 Docker PANEL。
EASYAIOT_ENABLE_PANEL=0

# 部署入口脚本（由 Panel 执行：bash $INSTALL_SCRIPT <action>）
INSTALL_SCRIPT=.scripts/docker/install_linux_arm.sh

