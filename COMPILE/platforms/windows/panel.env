# EasyAIoT PANEL — Windows 安装包默认配置

PANEL_LISTEN_HOST=0.0.0.0
PANEL_LISTEN_PORT=9200
PANEL_TOKEN=
PANEL_ALLOW_DANGEROUS=1
PANEL_JOB_TIMEOUT=7200

# 安装包内置 runtime（与 easyaiot-panel.exe 同级的 runtime/）
# run.bat 会自动设置；也可指向本机 clone 的仓库根
EASYAIOT_ROOT=

# 二进制 PANEL 与 Docker 版 PANEL 容器互斥：默认不自动拉起 PANEL 容器
EASYAIOT_ENABLE_PANEL=0

# Windows 仅镜像部署入口
INSTALL_SCRIPT=.scripts/docker/install_windows.sh
