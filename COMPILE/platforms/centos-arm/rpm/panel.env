# EasyAIoT PANEL 配置（CentOS/RHEL ARM RPM）
PANEL_LISTEN_HOST=0.0.0.0
PANEL_LISTEN_PORT=9200
PANEL_TOKEN=
PANEL_ALLOW_DANGEROUS=1
PANEL_JOB_TIMEOUT=7200

# EasyAIoT 仓库根路径（请按实际部署修改）
EASYAIOT_ROOT=/opt/easyaiot

# 部署入口：CentOS/RHEL ARM 一键脚本（装 Docker CE 后转交 install_linux_arm.sh）
INSTALL_SCRIPT=.scripts/docker/install_linux_centos_arm.sh
