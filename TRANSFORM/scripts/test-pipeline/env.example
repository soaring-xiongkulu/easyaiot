# Kafka / PG
KAFKA_BOOTSTRAP=127.0.0.1:9092
POSTGRES_URL=jdbc:postgresql://127.0.0.1:5432/iot-transform20
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=iot45722414822

# 本机默认 TRANSFORM（没有则测试脚本自动 jar 拉起）
LOCAL_TRANSFORM_PORT=48096
LOCAL_TRANSFORM_API=http://127.0.0.1:48096
LOCAL_NODE_ID=platform
LOCAL_INSTANCE_ID=local-default

# mock 外部系统
RECEIVER_HOST=127.0.0.1
RECEIVER_PORT=18080

TRANSFORM_IMAGE=easyaiot/transform-runtime:1.0.0
PIPELINE_MODE=full
PIPELINE_COUNT=1
PIPELINE_BASE_PORT=48110
TRANSFORM_ROLE=full

HEARTBEAT_TIMEOUT=120
BUSINESS_TIMEOUT=60
HTTP_TIMEOUT=10

# 清理旁路/mock；本机默认默认保留（KEEP_LOCAL_DEFAULT=1）
PIPELINE_CLEANUP=1
KEEP_LOCAL_DEFAULT=1
