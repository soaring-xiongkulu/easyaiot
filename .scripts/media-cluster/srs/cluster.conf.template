# SRS 集群节点配置模板
# 渲染: envsubst < cluster.conf.template > docker.conf
# 变量: MEDIA_NODE_ID, MEDIA_SCHEDULER_HOST, SRS_CANDIDATE_IP, SRS_RTC_PORT

listen              1935;
max_connections     500;
daemon              off;
srs_log_tank        file;
srs_log_file        /mnt/easyaiot-media/logs/srs-${MEDIA_NODE_ID}.log;

http_server {
    enabled         on;
    listen          8080;
    dir             ./objs/nginx/html;
}

http_api {
    enabled         on;
    listen          1985;
    raw_api {
        enabled             on;
        allow_reload        on;
    }
}

stats {
    network         0;
}

rtc_server {
    enabled         on;
    listen          ${SRS_RTC_PORT};
    candidate       ${SRS_CANDIDATE_IP};
}

vhost __defaultVhost__ {
    tcp_nodelay     on;
    min_latency     on;

    # edge_local 节点先在本机落 DVR，再由 SRS 原生转发同一 app/stream 到控制面。
    forward {
        enabled         ${SRS_FORWARD_ENABLED};
        destination     ${SRS_FORWARD_DESTINATION};
    }

    play {
        gop_cache       off;
        queue_length    10;
    }

    http_remux {
        enabled         on;
        mount           [vhost]/[app]/[stream].flv;
    }

    rtc {
        enabled         on;
        rtmp_to_rtc     on;
        rtc_to_rtmp     on;
    }

    dvr {
        enabled             on;
        dvr_path            /mnt/easyaiot-media/playbacks/[app]/[stream]/[2006]/[01]/[02]/[timestamp].flv;
        dvr_plan            segment;
        dvr_duration        60;
        dvr_wait_keyframe   on;
        time_jitter         full;
    }

    http_hooks {
        enabled             on;
        on_publish          http://${MEDIA_CONTROL_HOOK_HOST}:${MEDIA_CONTROL_HOOK_PORT}${MEDIA_CONTROL_HOOK_PATH_PREFIX}/video/media/hook/srs/on_publish;
        on_unpublish        http://${MEDIA_CONTROL_HOOK_HOST}:${MEDIA_CONTROL_HOOK_PORT}${MEDIA_CONTROL_HOOK_PATH_PREFIX}/video/media/hook/srs/on_unpublish;
        on_dvr              http://${MEDIA_DVR_HOOK_HOST}:${MEDIA_DVR_HOOK_PORT}${MEDIA_DVR_HOOK_PATH_PREFIX}${MEDIA_DVR_HOOK_PATH};
    }
}
