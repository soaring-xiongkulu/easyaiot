# EasyAIoT IDEA — 社区贡献在线 IDE
# cp idea.env.example idea.env

# 门户监听
IDEA_LISTEN_HOST=0.0.0.0
IDEA_LISTEN_PORT=9300

# 可选访问令牌（运维脚本 / 服务调用；与用户会话二选一即可）
IDEA_TOKEN=

# 贡献者镜像
IDEA_WORKSPACE_IMAGE=easyaiot/idea-workspace:latest
IDEA_PORTAL_IMAGE=easyaiot/idea-portal:latest

# 官方仓（默认全仓 clone）
IDEA_GIT_URL=https://gitee.com/volara/easyaiot.git
# 留空=完整历史；设为 1 可加速首次启动（仍打开全仓目录树）
IDEA_GIT_DEPTH=
# 容器内 reference 路径（配合下面 HOST 挂载）
IDEA_GIT_REFERENCE=

# code-server 对外基址（浏览器打开用；空则按请求 Host 推断）
IDEA_PUBLIC_HOST=
IDEA_PUBLIC_SCHEME=http

# 工作区端口池（宿主机映射，支持多人同时在线）
IDEA_PORT_START=13338
IDEA_PORT_END=13437

# 资源与生命周期
IDEA_CPUS=2
IDEA_MEMORY=4g
IDEA_MAX_WORKSPACES_PER_USER=1
IDEA_MAX_WORKSPACES=50

# 闲置自动停止（小时）；<=0 关闭。心跳/打开门户会刷新活跃时间
IDEA_IDLE_TIMEOUT_HOURS=8
IDEA_IDLE_CHECK_SECONDS=600

# 工作区数据目录（宿主机绝对路径；经 docker.sock 创建子容器时必须是宿主机路径）
# install.sh start 未设置时会自动用 IDEA/.data/workspaces
IDEA_DATA_DIR_HOST=
# 可选：git reference bare 仓在宿主机上的路径（例如 .../easyaiot.git）
IDEA_GIT_REFERENCE_HOST=
# compose 挂载 git-reference 父目录
IDEA_GIT_REFERENCE_DIR=

# ---------- OAuth（社区登录）----------
# 回调基址必须指向 IDEA 门户，例如 http://192.168.1.10:9300
IDEA_OAUTH_REDIRECT_BASE=
# 登录成功后跳回 WEB IDEA 页，例如 http://192.168.1.10:8888/idea/index
IDEA_WEB_CALLBACK=
# 会话签名密钥（生产请改成随机长串）
IDEA_SESSION_SECRET=
# 是否强制登录后才能创建工作区
IDEA_OAUTH_REQUIRED=0

# Gitee 应用（https://gitee.com/oauth/applications）
IDEA_GITEE_CLIENT_ID=
IDEA_GITEE_CLIENT_SECRET=
IDEA_GITEE_SCOPE=user_info

# GitHub OAuth App（https://github.com/settings/developers）
IDEA_GITHUB_CLIENT_ID=
IDEA_GITHUB_CLIENT_SECRET=
IDEA_GITHUB_SCOPE="read:user user:email"

# ---------- 本机模块发布（替换现网容器，不另开预览）----------
# 本机 EasyAIoT 仓库根目录（含 WEB/DEVICE/…）；空则 install.sh 会写成 IDEA 的上一级
IDEA_HOST_PROJECT_ROOT=
# 0 关闭「发布到本机」
IDEA_ALLOW_LOCAL_PUBLISH=1
# 打开现网按钮；空则 http://<host>:8888
IDEA_LIVE_URL=
IDEA_PUBLISH_TIMEOUT_SECONDS=3600
# 登录成功后跳回地址；空则回到 IDEA 门户本身（:9300/）
# IDEA_WEB_CALLBACK=http://192.168.1.10:9300/
