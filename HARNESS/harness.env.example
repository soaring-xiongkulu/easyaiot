# EasyAIoT HARNESS — 平台 AI Agent 助手
# cp harness.env.example harness.env

HARNESS_LISTEN_HOST=127.0.0.1
HARNESS_LISTEN_PORT=3080

# WEB 管控台 iframe 调 API 时追加 trusted-host（宿主机访问域名:8888，逗号分隔多个）
# 例：localhost:8888,192.168.1.10:8888
HARNESS_TRUSTED_HOSTS=

# Docker 镜像
HARNESS_IMAGE=easyaiot/harness:latest
# 固定上游 dsh 版本（Developer Preview，npm 当前为 0.1.0-rc.6）
DSH_VERSION=0.1.0-rc.6

# Agent 工作区：宿主机 EasyAIoT 仓库根目录（install.sh 未设置时自动为 HARNESS 上一级）
HARNESS_WORKSPACE_HOST=
HARNESS_WORKSPACE=/workspace/easyaiot

# 平台 Tool 插件访问 Gateway（容器内经 host-gateway）
EASYAIOT_GATEWAY_URL=http://host.docker.internal:48080

# 模型 API（任选其一；也可仅在 Web UI Settings → Models 中配置）
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
