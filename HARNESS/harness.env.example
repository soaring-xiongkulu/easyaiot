# EasyAIoT HARNESS — 平台 AI Agent 助手
# cp harness.env.example harness.env

HARNESS_LISTEN_HOST=127.0.0.1
HARNESS_LISTEN_PORT=3080

HARNESS_APP_NAME=EasyAIoT
HARNESS_APP_SHORT=EasyAIoT
HARNESS_HERO_HEADLINE=云边端一体化智能算法应用平台
HARNESS_HERO_HEADLINE_EN=
HARNESS_HERO_PREVIEW=

# WEB / IDEA 门户 iframe 调 API 时追加 trusted-host（域名:端口，逗号分隔）
# 例：localhost:8888,localhost:9300,192.168.1.10:9300
HARNESS_TRUSTED_HOSTS=

# Docker 镜像
HARNESS_IMAGE=easyaiot/harness:latest
# 固定上游 dsh 版本（Developer Preview，npm 当前为 0.1.0-rc.6）
DSH_VERSION=0.1.0-rc.6

# Agent 工作区：宿主机 EasyAIoT 仓库根目录（install.sh 未设置时自动为 HARNESS 上一级）
HARNESS_WORKSPACE_HOST=
HARNESS_WORKSPACE=/workspace/easyaiot
# Web UI 中显示的工作区标题（启动时自动注册，免手动「选择工作区」）
HARNESS_WORKSPACE_TITLE=EasyAIoT

# 文件树侧边栏（dsh-better-sidebar）：1=启用，0=关闭
HARNESS_ENABLE_SIDEBAR=1
HARNESS_SIDEBAR_PACKAGE=dsh-better-sidebar@0.12.1

# 平台 Tool 插件访问 Gateway（容器内经 host-gateway）
EASYAIOT_GATEWAY_URL=http://host.docker.internal:48080

# easyaiot_open_in_idea 生成的 IDEA 门户基址（浏览器可达，一般用宿主机 IP/域名）
EASYAIOT_IDEA_URL=http://127.0.0.1:9300

# 模型 API（任选其一；也可仅在 Web UI Settings → Models 中配置）
# DeepSeek Key 注册 / 充值：https://platform.deepseek.com/
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
