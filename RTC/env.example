# ============================================
# EasyAIoT RTC 模块环境变量
# ============================================

# Flask 管理服务
SECRET_KEY=your-rtc-secret-key-change-me
FLASK_RUN_HOST=0.0.0.0
FLASK_RUN_PORT=6100
DEBUG=False

# go2rtc 核心服务
GO2RTC_API_URL=http://127.0.0.1:1984
GO2RTC_CONFIG=/config/go2rtc.yaml
GO2RTC_USERNAME=
GO2RTC_PASSWORD=

# go2rtc 监听端口（写入配置文件）
GO2RTC_API_LISTEN=:1984
GO2RTC_RTSP_LISTEN=:8554
GO2RTC_WEBRTC_LISTEN=:8555

# Nacos 服务注册（可选）
NACOS_SERVER=localhost:8848
NACOS_NAMESPACE=
NACOS_USERNAME=nacos
NACOS_PASSWORD=basiclab@iot78475418754
SERVICE_NAME=rtc-server
POD_IP=

# 与 VIDEO 模块联动（可选）
VIDEO_SERVICE_URL=http://127.0.0.1:6000

# 时区
TZ=Asia/Shanghai
