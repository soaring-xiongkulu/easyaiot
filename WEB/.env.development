# 本地开发环境
NODE_ENV=development

# Vite 文件监视：true=轮询（避免 Linux inotify 上限 ENOSPC）；false=原生 inotify（更省 CPU）
VITE_USE_POLLING = true

# 资源公共路径,需要以 /开头和结尾
VITE_PUBLIC_PATH = /

# 本地开发代理，可以解决跨域及多地址代理
# 如果接口地址匹配到，则会转发到http://localhost:3000，防止本地出现跨域问题
# 可以有多个，注意多个不能换行，否则代理将会失效
# 说明：默认 /dev-api 走网关(48080)→VIDEO；若只单独启动 VIDEO 本机端口(如6000)，请在数组「靠前」增加：
# ["/dev-api/video","http://127.0.0.1:6000"] ，否则会转发到网关再由 lb://video-server 访问 VIDEO（需网关+Nacos 就绪）。
# 说明：/ai 与 /live 为 SRS HTTP-FLV 流（端口 8080，app=ai/live）；/rtp 为 ZLMediaKit(WVP/GB28181) ws-flv/http-flv 流（端口 6080）。
# 前端已把播放地址 host:port 改写为当前页面，这里把 /ai、/live 转给 SRS(8080)，/rtp 转给 ZLM(6080)。
# ⚠️ 若 SRS/ZLM 不在本机，请把对应的 127.0.0.1 改成实际主机 IP。/rtp 含 WebSocket，createProxy 已默认 ws:true。
VITE_PROXY = [["/ai","http://127.0.0.1:8080/ai"],["/live","http://127.0.0.1:8080/live"],["/rtp","http://127.0.0.1:6080/rtp"],["/dev-api/go2rtc","http://127.0.0.1:1984"],["/api/v1/buckets","http://127.0.0.1:9001/api/v1/buckets"],["/dev-api/vscode","http://127.0.0.1:10192"],["/dev-api/nodeRed","http://127.0.0.1:1880"],["/dev-api","http://127.0.0.1:48080/admin-api"]]

# 是否删除Console.log
VITE_DROP_CONSOLE = false

# 基础页面地址，例如 swagger 等页面
VITE_GLOB_BASE_URL = "http://localhost:48080"
# 接口地址,如果没有跨域问题，直接在这里配置即可
VITE_GLOB_API_URL = /dev-api

# 文件上传接口  可选
VITE_GLOB_UPLOAD_URL = http://localhost:48080/admin-api

# 接口地址前缀，有些系统所有接口地址都有前缀，可以在这里统一加，方便切换
VITE_GLOB_API_URL_PREFIX =

# 百度统计
VITE_APP_BAIDU_CODE = eb21166668bf766b9d059a6fd1c10777

# 天地图 API Key（开发环境；正式部署建议替换为自行申请的 Key，生产见 .env.production）
VITE_TIANDITU_KEY = b63042738fe261d09c04409bdb327567

# GPUStack 资源监测控制台（留空则使用当前访问域名 + 10180 端口）
VITE_GPUSTACK_URL =
VITE_GPUSTACK_USERNAME = admin
VITE_GPUSTACK_PASSWORD = basiclab@iotp4JWmQSvzdh0z4mF

# EasyAIoT PANEL 运维控制台（留空则使用当前访问域名 + 9200 端口）
VITE_PANEL_URL =

# 数据集批量上传最大并发数（未配置时默认 5）
VITE_UPLOAD_MAX_CONCURRENCY=10

# VISUALIZE 可视化编辑器地址（与 VISUALIZE/.env VITE_DEV_PORT 一致，固定 8002）
VITE_GLOB_VISUALIZE_URL = http://localhost:8002
# FUXA 组态编辑器（中间件 docker-compose FUXA 服务，端口 1881）
VITE_GLOB_FUXA_URL = http://localhost:1881
