# 本地开发环境
NODE_ENV=development

# 资源公共路径,需要以 /开头和结尾
VITE_PUBLIC_PATH = /

# 本地开发代理，可以解决跨域及多地址代理
# 如果接口地址匹配到，则会转发到http://localhost:3000，防止本地出现跨域问题
# 可以有多个，注意多个不能换行，否则代理将会失效
VITE_PROXY = [["/api/v1/buckets","http://10.0.0.87:9001/api/v1/buckets"],["/dev-api/vscode","http://127.0.0.1:10192"],["/dev-api/nodeRed","http://10.0.0.87:1880"],["/dev-api","http://127.0.0.1:48080/admin-api"]]
# VITE_PROXY=[["/api","http://vben.xingyuv.com/test"]]

# 是否删除Console.log
VITE_DROP_CONSOLE = false

# 基础页面地址，例如 swagger 等页面
VITE_GLOB_BASE_URL = "http://localhost:48080"
# 接口地址,如果没有跨域问题，直接在这里配置即可
VITE_GLOB_API_URL = /dev-api


# 文件上传接口（容器/nginx 部署须用相对路径，与 VITE_GLOB_API_URL 一致走 /dev-api；
# mini 无 Gateway，/dev-api/model/** 由 nginx 直连 AI；/dev-api/dataset/** 等走 iot-system）
VITE_GLOB_UPLOAD_URL = /dev-api

# 接口地址前缀，有些系统所有接口地址都有前缀，可以在这里统一加，方便切换
VITE_GLOB_API_URL_PREFIX =

# 百度统计
VITE_APP_BAIDU_CODE = eb21166668bf766b9d059a6fd1c10777

# 天地图 API Key（生产环境；正式部署建议替换为自行申请的 Key 并绑定域名白名单）
VITE_TIANDITU_KEY = b63042738fe261d09c04409bdb327567

# GPUStack 资源监测控制台（留空则使用当前访问域名 + 10180 端口）
VITE_GPUSTACK_URL =
VITE_GPUSTACK_USERNAME = admin
VITE_GPUSTACK_PASSWORD = basiclab@iotp4JWmQSvzdh0z4mF

# EasyAIoT PANEL 运维控制台（留空则使用当前访问域名 + 9200 端口）
VITE_PANEL_URL =

# 数据集批量上传最大并发数（未配置时默认 5）
VITE_UPLOAD_MAX_CONCURRENCY=10

# VISUALIZE 可视化编辑器（/visualize → 浏览器解析为当前主机:8002）
# 生产目录：nginx html/visualize，与 WEB 的 html/dist 同级；见 WEB/conf/nginx.prod-server.conf
VITE_GLOB_VISUALIZE_URL = /visualize
# FUXA：/fuxa → 当前主机:1881（本机 nginx 反代到容器 10.0.0.87:1881）
# 须与 iot.fuxa.public-url（反代入口）一致，勿写成容器内网地址
VITE_GLOB_FUXA_URL = /fuxa
